{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRChat VRCA Downloader",
  "version": "2.0.3",
  "identifier": "com.puddingkc.vrca-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRChat VRCA Downloader",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}

