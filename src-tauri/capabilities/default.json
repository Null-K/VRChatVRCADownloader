{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for VRChat VRCA Downloader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-create",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:scope-appdata-recursive",
    "fs:scope-download-recursive",
    "fs:scope-document-recursive",
    "fs:scope-desktop-recursive",
    "shell:allow-open"
  ]
}
